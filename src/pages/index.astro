---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarHub from '../components/PillarHub.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { pillars } from '../data/pillars';
import home from '../content/pages/home.json';
---
<BaseLayout
  title="Home"
  description="Free daily habits for a stronger mind and body — exercise, diet, supplements, mental health, and immune health."
  transparentHeader
>
  <img
    class="hero-banner"
    src="/images/hero-mountain.png"
    alt="A person standing on a mountain summit with arms raised, overlooking a lake and mountains at sunrise"
    width="1120"
    height="310"
  />

  <section class="hero">
    <div class="container hero__copy">
      <p class="eyebrow">{home.heroEyebrow}</p>
      <h1>{home.heroTitle}</h1>
      <p class="hero__subtitle">{home.heroSubtitle}</p>
      <a href="#pillars" class="button">{home.heroButtonLabel}</a>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">{home.missionEyebrow}</p>
      <h2>{home.missionHeading}</h2>
      <p>{home.missionBody}</p>
      <a href="/about" class="button button--outline">{home.missionButtonLabel}</a>
    </div>
  </section>

  <section class="section" id="pillars">
    <div class="container">
      <p class="eyebrow">{home.pillarsEyebrow}</p>
      <h2>{home.pillarsHeading}</h2>
      <PillarHub pillars={pillars} />
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">{home.askEyebrow}</p>
      <h2>{home.askHeading}</h2>
      <ChatWidget />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-banner {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero {
    padding-block: var(--space-6);
  }

  .hero__copy h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    max-width: 20ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 56ch;
  }
</style>
