---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarCard from '../components/PillarCard.astro';
import TipCard from '../components/TipCard.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { pillars } from '../data/pillars';

const featuredTips = (await getCollection('tips', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---
<BaseLayout
  title="Home"
  description="Free daily habits for a stronger mind and body — exercise, diet, supplements, mental health, and immune health."
  transparentHeader
>
  <img
    class="hero-banner"
    src="/images/hero-mountain.png"
    alt="A person standing on a mountain summit with arms raised, overlooking a lake and mountains at sunrise"
    width="1120"
    height="310"
  />

  <section class="hero">
    <div class="container hero__copy">
      <p class="eyebrow">Change Mind, Change Body</p>
      <h1>Change your mind. Change your body. It starts with one habit.</h1>
      <p class="hero__subtitle">
        Every tip on this site is completely free — no sign-up, no program to buy, no catch.
        Just daily habits we've learned through real experience and continued education, shared
        so you can put them to use today.
      </p>
      <a href="#pillars" class="button">Explore the Pillars</a>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">Our Mission</p>
      <h2>Free knowledge, shared without strings attached.</h2>
      <p>
        We believe changing your body starts with changing your mind — and that the habits which
        make that possible shouldn't be locked behind a paywall. Everything here is free to read,
        free to use, forever.
      </p>
      <a href="/about" class="button button--outline">Read Our Story &rarr;</a>
    </div>
  </section>

  <section class="section" id="pillars">
    <div class="container">
      <p class="eyebrow">Five Pillars</p>
      <h2>Pick a pillar, start today.</h2>
      <div class="grid-pillars">
        {pillars.map((pillar) => <PillarCard pillar={pillar} />)}
      </div>
    </div>
  </section>

  {featuredTips.length > 0 && (
    <section class="section section--muted">
      <div class="container">
        <p class="eyebrow">Recent Picks</p>
        <h2>A few habits worth starting this week.</h2>
        <div class="grid-tips">
          {featuredTips.map((tip) => <TipCard tip={tip} showPillarLink />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">Ask Us</p>
      <h2>Have a question? Ask right here.</h2>
      <ChatWidget />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-banner {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero {
    padding-block: var(--space-6);
  }

  .hero__copy h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    max-width: 20ch;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 56ch;
  }
</style>
