---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getFileContent } from '../../../lib/github';
import { PAGE_FIELDS } from '../../../lib/pageFields';

const { page } = Astro.params as { page: string };
const fields = PAGE_FIELDS[page];

if (!fields) {
  return Astro.redirect('/admin');
}

const raw = await getFileContent(`src/content/pages/${page}.json`);
const data: Record<string, string> = raw ? JSON.parse(raw) : {};

const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.has('saved');
const pageLabel = page === 'home' ? 'Home Page' : 'About Page';
---

<BaseLayout title={`Edit ${pageLabel}`} description="Content editor">
  <section class="container admin-form-page">
    <p><a href="/admin">&larr; Back to dashboard</a></p>
    <h1>{pageLabel} Copy</h1>

    {error && <p class="admin-message admin-message--error">{error}</p>}
    {saved && <p class="admin-message">Saved.</p>}

    <form method="POST" action="/api/admin/pages/save" class="admin-form">
      <input type="hidden" name="page" value={page} />
      {
        fields.map((field) =>
          field.multiline ? (
            <label>
              {field.label}
              <textarea name={field.name} rows="3" required>{data[field.name] ?? ''}</textarea>
            </label>
          ) : (
            <label>
              {field.label}
              <input type="text" name={field.name} required value={data[field.name] ?? ''} />
            </label>
          ),
        )
      }
      <button type="submit" class="button">Save</button>
    </form>
  </section>

  <style>
    .admin-form-page {
      padding-block: var(--space-6);
      max-width: 40rem;
    }

    .admin-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-top: var(--space-4);
    }

    .admin-form label {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      font-weight: 600;
    }

    .admin-form input,
    .admin-form textarea {
      font: inherit;
      padding: var(--space-2);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: var(--color-surface);
      color: var(--color-text);
    }

    .admin-form button {
      align-self: flex-start;
      cursor: pointer;
    }

    .admin-message {
      padding: var(--space-2) var(--space-3);
      border-radius: 8px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      margin-bottom: var(--space-3);
    }

    .admin-message--error {
      color: #b3261e;
      border-color: #f2c0bb;
      background: #fdf0ee;
    }
  </style>
</BaseLayout>
