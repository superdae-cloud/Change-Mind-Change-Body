---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFileContent } from '../../lib/github';
import type { Pillar } from '../../data/pillars';

const raw = await getFileContent('src/data/pillars.json');
const pillars: Pillar[] = raw ? JSON.parse(raw) : [];

const error = Astro.url.searchParams.get('error');
const saved = Astro.url.searchParams.has('saved');
---

<BaseLayout title="Edit Pillar Cards" description="Content editor">
  <section class="container admin-form-page">
    <p><a href="/admin">&larr; Back to dashboard</a></p>
    <h1>Pillar Cards</h1>

    {error && <p class="admin-message admin-message--error">{error}</p>}
    {saved && <p class="admin-message">Saved.</p>}

    <form method="POST" action="/api/admin/pillars/save" class="admin-form">
      {
        pillars.map((pillar) => (
          <fieldset class="admin-fieldset">
            <legend>{pillar.slug}</legend>
            <input type="hidden" name={`slug_${pillar.slug}`} value={pillar.slug} />
            <label>
              Title
              <input type="text" name={`title_${pillar.slug}`} required value={pillar.title} />
            </label>
            <label>
              Emoji
              <input type="text" name={`emoji_${pillar.slug}`} required value={pillar.emoji} />
            </label>
            <label>
              Blurb
              <input type="text" name={`blurb_${pillar.slug}`} required value={pillar.blurb} />
            </label>
            <label>
              Color
              <input type="color" name={`color_${pillar.slug}`} required value={pillar.color} />
            </label>
          </fieldset>
        ))
      }
      <button type="submit" class="button">Save All</button>
    </form>
  </section>

  <style>
    .admin-form-page {
      padding-block: var(--space-6);
      max-width: 40rem;
    }

    .admin-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }

    .admin-fieldset {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .admin-fieldset legend {
      font-weight: 700;
      text-transform: capitalize;
      padding-inline: var(--space-1);
    }

    .admin-form label {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      font-weight: 600;
    }

    .admin-form input {
      font: inherit;
      padding: var(--space-2);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: var(--color-surface);
      color: var(--color-text);
    }

    .admin-form button {
      align-self: flex-start;
      cursor: pointer;
    }

    .admin-message {
      padding: var(--space-2) var(--space-3);
      border-radius: 8px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      margin-bottom: var(--space-3);
    }

    .admin-message--error {
      color: #b3261e;
      border-color: #f2c0bb;
      background: #fdf0ee;
    }
  </style>
</BaseLayout>
