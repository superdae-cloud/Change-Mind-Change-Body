---
import { getCollection } from 'astro:content';
import PillarLayout from '../layouts/PillarLayout.astro';

const tips = (await getCollection('tips', ({ data }) => data.pillar === 'bro-science' && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<PillarLayout
  pillarSlug="bro-science"
  intro="Gym-floor wisdom, myths, and old wives' tales, tested against what the research actually says."
  tips={tips}
/>
