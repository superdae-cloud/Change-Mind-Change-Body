---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PillarCard from '../components/PillarCard.astro';
import { pillars } from '../data/pillars';
import about from '../content/pages/about.json';
---
<BaseLayout
  title="About"
  description="Why Change Mind, Change Body exists: free daily habits that change your mind and your body."
>
  <Hero
    eyebrow={about.heroEyebrow}
    title={about.heroTitle}
    subtitle={about.heroSubtitle}
  />

  <section class="section">
    <div class="container">
      <p class="eyebrow">{about.whyEyebrow}</p>
      <h2>{about.whyHeading}</h2>
      <p>{about.whyParagraph1}</p>
      <p>{about.whyParagraph2}</p>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <p class="eyebrow">{about.freeEyebrow}</p>
      <h2>{about.freeHeading}</h2>
      <p>{about.freeParagraph}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{about.pillarsEyebrow}</p>
      <h2>{about.pillarsHeading}</h2>
      <div class="grid-pillars">
        {pillars.map((pillar) => <PillarCard pillar={pillar} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <h2>{about.closingHeading}</h2>
      <p>{about.closingParagraph}</p>
    </div>
  </section>
</BaseLayout>
