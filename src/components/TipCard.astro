---
import type { CollectionEntry } from 'astro:content';
import { pillars } from '../data/pillars';

interface Props {
  tip: CollectionEntry<'tips'>;
  showPillarLink?: boolean;
}
const { tip, showPillarLink = false } = Astro.props;
const { title, summary, tags, pillar } = tip.data;
const pillarInfo = pillars.find((p) => p.slug === pillar);
---
<article class="tip-card" style={`--pillar-color: ${pillarInfo?.color ?? 'var(--color-accent)'}`}>
  {showPillarLink && pillarInfo && (
    <a href={`/${pillarInfo.slug}`} class="tip-card__pillar">{pillarInfo.emoji} {pillarInfo.title}</a>
  )}
  <h3>{title}</h3>
  <p>{summary}</p>
  {tags.length > 0 && (
    <ul class="tip-card__tags">
      {tags.map((tag: string) => <li>{tag}</li>)}
    </ul>
  )}
</article>

<style>
  .tip-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--pillar-color);
    border-radius: var(--radius);
    padding: var(--space-4);
  }

  .tip-card__pillar {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--pillar-color);
    text-decoration: none;
    margin-bottom: var(--space-2);
  }

  .tip-card h3 {
    margin-top: 0;
    margin-bottom: var(--space-2);
    font-size: 1.1rem;
  }

  .tip-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .tip-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .tip-card__tags li {
    font-size: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    color: var(--color-text-muted);
  }
</style>
