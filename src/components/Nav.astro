---
import { pillars } from '../data/pillars';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  ...pillars.map((p) => ({ href: `/${p.slug}`, label: p.title })),
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class:list={['nav', { 'nav--light': light }]}>
  <ul>
    {links.map((link) => {
      const isActive = (link.href === '/' ? currentPath === '/' : currentPath === link.href);
      return (
        <li>
          <a href={link.href} aria-current={isActive ? 'page' : undefined}>{link.label}</a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }

  .nav a {
    text-decoration: none;
    font-weight: 600;
    color: var(--color-text-muted);
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    color: var(--color-text);
  }

  .nav a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-accent);
  }

  .nav--light a {
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .nav--light a:hover {
    color: #fff;
  }

  .nav--light a[aria-current='page'] {
    color: #fff;
    border-bottom-color: #fff;
  }
</style>
