---
import type { Pillar } from '../data/pillars';

interface Props {
  pillar: Pillar;
}
const { pillar } = Astro.props;
---
<a href={`/${pillar.slug}`} class="pillar-card" style={`--pillar-color: ${pillar.color}`}>
  <span class="pillar-card__emoji" aria-hidden="true">{pillar.emoji}</span>
  <h3>{pillar.title}</h3>
  <p>{pillar.blurb}</p>
  <span class="pillar-card__link">View tips &rarr;</span>
</a>

<style>
  .pillar-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--pillar-color);
    border-radius: var(--radius);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow);
    transition: transform 0.15s ease;
  }

  .pillar-card:hover {
    transform: translateY(-2px);
  }

  .pillar-card__emoji {
    font-size: 1.8rem;
  }

  .pillar-card h3 {
    margin-block: var(--space-2);
  }

  .pillar-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .pillar-card__link {
    font-weight: 700;
    color: var(--pillar-color);
  }
</style>
