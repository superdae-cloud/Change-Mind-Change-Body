ANTHROPIC_API_KEY=your_api_key_here

# Admin login for /admin (content editor)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Random secret used to sign admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Fine-grained GitHub personal access token with Contents: Read and write
# on this repo. Used by the admin editor to commit content changes.
GITHUB_TOKEN=your_github_token
